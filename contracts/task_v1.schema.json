{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-hub-cloud/task_v1",
  "title": "Task message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "type", "source", "payload", "dedupe_key", "created_at"],
  "properties": {
    "schema": {"const": "v1"},
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {"enum": ["telegram_job_link", "drive_file", "ocr_job_image"]},
    "source": {"enum": ["telegram", "drive"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "file_id", "version", "text"],
      "properties": {
        "url": {"type": ["string", "null"], "maxLength": 2000, "pattern": "^https://"},
        "file_id": {"type": ["string", "null"], "maxLength": 300},
        "version": {"type": ["string", "null"], "maxLength": 64},
        "text": {"type": ["string", "null"], "maxLength": 4000},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "mime": {"type": ["string", "null"], "enum": [null, "image/png", "image/jpeg", "image/webp", "application/pdf", "text/plain"]}
      }
    },
    "dedupe_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 40}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "telegram_job_link"}}},
      "then": {"properties": {"source": {"const": "telegram"}, "payload": {"properties": {"url": {"type": "string"}}}}}
    },
    {
      "if": {"properties": {"type": {"enum": ["drive_file", "ocr_job_image"]}}},
      "then": {"properties": {"payload": {"properties": {"file_id": {"type": "string"}, "sha256": {"type": "string"}}, "required": ["sha256"]}}}
    }
  ]
}
