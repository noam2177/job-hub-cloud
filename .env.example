# Copy to .env and fill locally. Never commit .env. Cloud values live in Secret Manager.

# GCP (identifiers only; no key files)
GCP_PROJECT_ID=<your-project-id>
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
BQ_DATASET=jobs
BQ_LOCATION=US

# Pub/Sub
PUBSUB_TOPIC_TASKS=tasks
PUBSUB_TOPIC_DLQ=tasks-dlq
PUBSUB_SUB_LOCAL=tasks-local

# Telegram intake bot (dedicated; NOT the Hub bot). On the VM this comes from Secret Manager.
TELEGRAM_INTAKE_BOT_TOKEN=<from-secret-manager>
TELEGRAM_INTAKE_ALLOWED_CHAT_IDS=<comma-separated-numeric-ids>

# Local side
CAREER_DRIVE_BUS_DIR=<local-drive-sync-folder>
JOBHUB_STATE_DIR=./state
JOBHUB_DRY_RUN=1

# Local models (loopback only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=qwen3-vl:8b-instruct
